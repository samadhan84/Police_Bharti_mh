# API base URL baked into the build.
#   browser/desktop dev : http://localhost:5080/api
#   Android emulator    : http://10.0.2.2:5080/api
#   real phone / prod   : https://your-server.example.com/api
# Leave unset for local dev (Vite proxies /api to localhost:5080). Set it only for builds (Electron/Android).
# VITE_API_URL=http://localhost:5080/api
